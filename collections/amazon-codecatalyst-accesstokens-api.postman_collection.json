        {
          "id": "705f866c-eb20-42db-846a-6b9f16dcf4c1",
          "name": "Amazon CodeCatalyst Delete Access Token",
          "request": {
            "name": "Amazon CodeCatalyst Delete Access Token",
            "description": {
              "content": "Deletes a specified personal access token (PAT). A personal access token can only be deleted by the user who created it.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "accessTokens",
                ":id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "id",
                  "description": "(Required) The ID of the personal access token to delete. You can find the IDs of all PATs associated with your Amazon Web Services Builder ID in a space by calling <a>ListAccessTokens</a>."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
