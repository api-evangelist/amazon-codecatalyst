{
  "opencollection": "1.0.0",
  "info": {
    "name": "Amazon CodeCatalyst AccessTokens Session API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Session",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Amazon CodeCatalyst Verify Session",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://codecatalyst.global.api.aws/session"
          },
          "docs": "Verifies whether the calling user has a valid Amazon CodeCatalyst login and session. If successful, this returns the ID of the user in Amazon CodeCatalyst."
        }
      ]
    }
  ],
  "bundled": true
}